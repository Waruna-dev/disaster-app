rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ======================================================================
    // REUSABLE FUNCTIONS
    // ======================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated()
        && request.auth.uid == userId;
    }

    // Admin check using the `role` field on the user profile document.
    // 'occupation' does not grant admin.
    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isPendingReport() {
      return resource.data.status == 'Pending';
    }

    // Validation for Profile Images (Supports URL string and Cloudinary metadata object)
    function hasValidProfileImage() {
      return !('profileImage' in request.resource.data)
        || request.resource.data.profileImage == null
        || (
          request.resource.data.profileImage is string
          && request.resource.data.profileImage.size() > 0
          && request.resource.data.profileImage.size() <= 2048
        )
        || (
          request.resource.data.profileImage is map
          && request.resource.data.profileImage.keys().hasAll(['url'])
          && request.resource.data.profileImage.url is string
          && request.resource.data.profileImage.url.size() > 0
          && request.resource.data.profileImage.url.size() <= 2048
          // Allow all the Cloudinary fields the frontend sends
        );
    }

    // ======================================================================
    // USERS
    // ======================================================================

    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isOwner(userId)
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        && (!('fullName' in request.resource.data) || request.resource.data.fullName is string)
        && (!('email' in request.resource.data) || request.resource.data.email is string)
        && hasValidProfileImage();

      allow update: if isAdmin() || (
        isOwner(userId)
        // Protected fields
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role',
          'email',
          'createdAt'
        ])
        && hasValidProfileImage()
      );

      allow delete: if isAdmin();
    }

    // ======================================================================
    // REPORTS
    // ======================================================================

    match /reports/{reportId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'Pending'
        // Do not allow creating with review data
        && !request.resource.data.keys().hasAny([
          'reviewedBy',
          'reviewedAt',
          'rejectionReason'
        ]);

      allow update: if isAdmin() || (
        isAuthenticated()
        && resource.data.userId == request.auth.uid
        && isPendingReport()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.status == resource.data.status
        // Users cannot modify review data
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'userId',
          'status',
          'reviewedBy',
          'reviewedAt',
          'rejectionReason'
        ])
      );

      allow delete: if isAdmin() || (
        isAuthenticated()
        && resource.data.userId == request.auth.uid
        && isPendingReport()
      );
    }

    // ======================================================================
    // OFFICIAL WARNINGS / ALERTS
    // ======================================================================

    match /warnings/{warningId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ======================================================================
    // FLOOD INCIDENT REVIEWS
    // ======================================================================

    match /floodIncidentReviews/{incidentId} {
      allow read, create, update, delete: if isAdmin();
    }

    // ======================================================================
    // SHELTERS / RESCUE / RESOURCES / OFFICER LOG (citizen app + officer-web)
    // ======================================================================


    match /shelters/{id} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    match /shelterRequests/{id} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'Pending';
      allow update, delete: if isAdmin();
    }
    match /rescueTeams/{id} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    match /rescueRequests/{id} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'Pending';
      allow update, delete: if isAdmin();
    }
    match /resources/{id} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    match /resourceDistributions/{id} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    // Officer-only (new for the web portal)
    match /activities/{id} {
      allow read, create, update, delete: if isAdmin();
    }
    match /rescueAssignments/{id} {
      allow read, create, update, delete: if isAdmin();
    }

    // ======================================================================
    // DEFAULT DENY
    // ======================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
